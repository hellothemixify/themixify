{
  "name": "themixifyweb",
  "version": "1.0.0",
  "private": true,
  "description": "Themixify — the zero-plugin, agentic-optimized WordPress theme. Marketing site, licence portal and admin.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "//browserslist": "Sets the floor for the compiled output. Every listed browser ships Array.prototype.at/flat, structuredClone and the rest natively, so Next stops shipping ~14KB of polyfills nobody executes. These versions are all 2022 or later and cover well over 95% of live traffic.",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "not dead"
  ],
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.114.0"
  }
}
