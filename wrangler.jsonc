{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "themixify",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",

  // Next.js runs on Node APIs, so the Worker needs the Node compatibility
  // layer. "global_fetch_strictly_public" makes fetch() inside the Worker
  // behave the way it does everywhere else — requests to our own hostname go
  // out to the public internet rather than looping back internally.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static assets (the prerendered pages, CSS and JS) are served straight from
  // Cloudflare's edge; the Worker only runs for the handful of dynamic routes.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Keep the workers.dev hostname alive alongside the custom domains. It is the
  // only way in while DNS is propagating, and it stays useful afterwards as a
  // way to hit the deployment directly without going through the domain.
  "workers_dev": true,
  "preview_urls": true,

  // The production hostnames. Declared here rather than clicked into the
  // dashboard so the routing lives in version control with everything else —
  // a fresh clone can reproduce the whole deployment.
  //
  // www is attached too, and the app's canonical tags point every page at the
  // apex, so the two hostnames never compete for the same ranking.
  "routes": [
    { "pattern": "themixify.com", "custom_domain": true },
    { "pattern": "www.themixify.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
